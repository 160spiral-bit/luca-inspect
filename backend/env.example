# Luca AI — Environment Variables Template
# Copy this file to .env and fill in your API keys.
# NEVER commit .env to git — it contains your secret keys.

# Provider API keys
OPENROUTER_KEY=your_openrouter_key_here
OPENROUTER_KEY_2=your_second_openrouter_key_here
CROWLLM_KEY=your_crowllm_key_here
LOGFARE_KEY=your_logfare_key_here
UGLYCAT_KEY=your_uglycat_key_here
AGNES_KEY=your_agnes_key_here
FXQIDIAN_KEY=your_fxqidian_key_here
GOOGLE_KEY=your_google_key_here
ZYDIT_KEY=your_zydit_key_here
HCNSEC_KEY=your_hcnsec_key_here
YJS_KEY=your_yjs_key_here
UNOROUTER_KEY=your_unorouter_key_here

# Server config
PORT=3000

# MCP servers (Model Context Protocol, Streamable HTTP). JSON array — each
# server's tools become callable as mcp__<name>__<tool> in the agent loop.
# Example:
# MCP_SERVERS=[{"name":"docs","url":"https://mcp.example.com/mcp","headers":{"Authorization":"Bearer TOKEN"}}]
MCP_SERVERS=[]
