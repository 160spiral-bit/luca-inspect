{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luca-ai",
  "compatibility_date": "2026-08-20",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "not_found_handling": "single-page-application",
    "exclude": [
      "node_modules/**",
      ".git/**",
      ".wrangler/**",
      "*.log",
      "*.exe"
    ]
  }
}